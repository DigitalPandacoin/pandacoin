FROM ubuntu:trusty

#Default branch name develop
ARG BRANCH_NAME=develop
#Default
ARG REPO_SLUG=amDOGE/pandacoin
ENV REPO_SLUG=${REPO_SLUG}
ENV REPO_URL=https://gitlab.com/${REPO_SLUG}

RUN apt-get -qq update && \
    apt-get -qqy install \
    git \
    sudo

#RUN git clone ${REPO_URL} --branch $BRANCH_NAME --single-branch --depth 1

COPY pandacoin.tar.gz /pandacoin.tar.gz
RUN tar -xvf /pandacoin.tar.gz

#xenial
#Missing requirement: libtool
#RUN apt install -yqq libtool-bin
RUN cd /pandacoin/scripts/windows-crosscompile && ./dependencies.sh
RUN cd /pandacoin && scripts/windows-crosscompile/compile-pandacoin.sh
